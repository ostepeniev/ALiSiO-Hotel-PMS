const Database = require('better-sqlite3');
const db = new Database('/root/projects/alisio-pms/data/alisio.db');
try {
  const leads = db.prepare("SELECT id, first_name, last_name, external_booking_id, source FROM crm_leads WHERE external_booking_id IN ('5326802585', '6688814746')").all();
  console.log('--- Leads in CRM ---');
  console.log(JSON.stringify(leads, null, 2));

  const messages = db.prepare("SELECT id, external_id, metadata_json FROM crm_messages WHERE metadata_json LIKE '%5326802585%' OR metadata_json LIKE '%6688814746%'").all();
  console.log('--- Messages in CRM ---');
  console.log(JSON.stringify(messages, null, 2));
} catch (err) {
  console.error(err.message);
}
