const { ImapFlow } = require('imapflow');
const fs = require('fs');
const path = require('path');

async function testSeznam() {
    // Read from .env.local
    const envPath = path.join(__dirname, '.env.local');
    const envContent = fs.readFileSync(envPath, 'utf8');
    const lines = envContent.split('\n');
    let user, pass;
    
    for (const line of lines) {
        if (line.startsWith('EMAIL_CZ_USER=')) user = line.split('=')[1].trim();
        if (line.startsWith('EMAIL_CZ_PASSWORD=')) pass = line.split('=')[1].trim();
    }

    console.log(`Testing with user: ${user}`);
    
    const client = new ImapFlow({
        host: 'imap.seznam.cz',
        port: 993,
        secure: true,
        auth: { user, pass },
        logger: false
    });

    try {
        await client.connect();
        console.log('✅ Connected successfully!');
        const status = await client.status('INBOX', { unread: true });
        console.log('📬 Mailbox status:', status);
        await client.logout();
    } catch (err) {
        console.error('❌ Connection failed:', err.message);
        if (err.response) console.error('Server response:', err.response);
    }
}

testSeznam();
