const { ImapFlow } = require('imapflow');
const fs = require('fs');
const path = require('path');
const Database = require('better-sqlite3');

async function auditBookingEmails() {
    const db = new Database('/root/projects/alisio-pms/data/alisio.db');
    const envPath = path.join(__dirname, '.env.local');
    const envContent = fs.readFileSync(envPath, 'utf8');
    const lines = envContent.split('\n');
    let user, pass;
    
    for (const line of lines) {
        if (line.startsWith('EMAIL_CZ_USER=')) user = line.split('=')[1].trim();
        if (line.startsWith('EMAIL_CZ_PASSWORD=')) pass = line.split('=')[1].trim();
    }

    const client = new ImapFlow({
        host: 'imap.seznam.cz', port: 993, secure: true,
        auth: { user, pass }, logger: false
    });

    try {
        await client.connect();
        const lock = await client.getMailboxLock('INBOX');
        try {
            const searchCriteria = {
                header: { field: 'from', value: 'booking.com' },
                since: new Date('2026-04-24T00:00:00Z')
            };

            const messages = client.fetch(searchCriteria, { envelope: true, uid: true });

            console.log('--- Audit Summary ---');
            for await (const msg of messages) {
                const env = msg.envelope;
                const messageId = env.messageId;
                const subject = env.subject;
                
                const processed = db.prepare("SELECT category FROM email_processed WHERE message_id = ?").get(messageId);
                const lead = db.prepare("SELECT id FROM crm_leads WHERE external_booking_id LIKE ? OR id IN (SELECT lead_id FROM crm_conversations WHERE id IN (SELECT conversation_id FROM crm_messages WHERE external_id = ?))")
                               .get(`%${subject.match(/\d{10}/)?.[0]}%`, messageId);

                console.log(`UID:${msg.uid} | Subj:${subject}`);
                console.log(`  - Processed category: ${processed ? processed.category : 'NOT PROCESSED'}`);
                console.log(`  - Linked Lead ID: ${lead ? lead.id : 'NOT LINKED'}`);
            }
        } finally {
            lock.release();
        }
        await client.logout();
    } catch (err) {
        console.error('Error:', err.message);
    }
}

auditBookingEmails();
