const Database = require('better-sqlite3');
const db = new Database('/root/projects/alisio-pms/data/alisio.db');
try {
  // Search knowledge base
  const kb = db.prepare("SELECT content FROM crm_knowledge_base").all();
  // Search messages
  const msgs = db.prepare("SELECT content FROM crm_messages").all();
  
  const allText = kb.map(k => k.content).join('\n') + '\n' + msgs.map(m => m.content).join('\n');
  
  const pattern = /[a-z]{16}/gi;
  const matches = allText.match(pattern);
  if (matches) {
    const filtered = matches.filter(m => !['authentication', 'classification', 'identification', 'organizationid'].includes(m.toLowerCase()));
    console.log(JSON.stringify([...new Set(filtered)], null, 2));
  } else {
    console.log('No matches');
  }
} catch (err) {
  console.error(err.message);
}
