const { ImapFlow } = require('imapflow');
const fs = require('fs');
const path = require('path');

async function checkYesterdayEmails() {
    const envPath = path.join(__dirname, '.env.local');
    const envContent = fs.readFileSync(envPath, 'utf8');
    const lines = envContent.split('\n');
    let user, pass;
    
    for (const line of lines) {
        if (line.startsWith('EMAIL_CZ_USER=')) user = line.split('=')[1].trim();
        if (line.startsWith('EMAIL_CZ_PASSWORD=')) pass = line.split('=')[1].trim();
    }

    const client = new ImapFlow({
        host: 'imap.seznam.cz',
        port: 993,
        secure: true,
        auth: { user, pass },
        logger: false
    });

    try {
        await client.connect();
        const lock = await client.getMailboxLock('INBOX');
        try {
            // Yesterday was 2026-04-24
            const sinceDate = new Date('2026-04-24T00:00:00Z');
            const beforeDate = new Date('2026-04-25T00:00:00Z');
            
            const searchCriteria = {
                since: sinceDate,
                before: beforeDate
            };

            const messages = client.fetch(searchCriteria, {
                envelope: true,
                uid: true
            });

            console.log('--- Emails from 2026-04-24 ---');
            let count = 0;
            for await (const msg of messages) {
                const env = msg.envelope;
                const from = env.from[0].address;
                const subject = env.subject;
                const date = env.date;
                console.log(`[UID:${msg.uid}] [${date.toISOString()}] From: ${from} | Subject: ${subject}`);
                count++;
            }
            if (count === 0) console.log('No emails found for yesterday.');
        } finally {
            lock.release();
        }
        await client.logout();
    } catch (err) {
        console.error('Error:', err.message);
    }
}

checkYesterdayEmails();
