const { ImapFlow } = require('imapflow');
const fs = require('fs');
const path = require('path');

async function getBookingMessageIds() {
    const envPath = path.join(__dirname, '.env.local');
    const envContent = fs.readFileSync(envPath, 'utf8');
    const lines = envContent.split('\n');
    let user, pass;
    
    for (const line of lines) {
        if (line.startsWith('EMAIL_CZ_USER=')) user = line.split('=')[1].trim();
        if (line.startsWith('EMAIL_CZ_PASSWORD=')) pass = line.split('=')[1].trim();
    }

    const client = new ImapFlow({
        host: 'imap.seznam.cz',
        port: 993,
        secure: true,
        auth: { user, pass },
        logger: false
    });

    try {
        await client.connect();
        const lock = await client.getMailboxLock('INBOX');
        try {
            const searchCriteria = {
                header: { field: 'from', value: 'booking.com' },
                since: new Date('2026-04-24T00:00:00Z')
            };

            const messages = client.fetch(searchCriteria, {
                envelope: true,
                uid: true
            });

            console.log('--- Booking.com Emails ---');
            for await (const msg of messages) {
                const env = msg.envelope;
                console.log(`UID:${msg.uid} | ID:${env.messageId} | Subj:${env.subject}`);
            }
        } finally {
            lock.release();
        }
        await client.logout();
    } catch (err) {
        console.error('Error:', err.message);
    }
}

getBookingMessageIds();
